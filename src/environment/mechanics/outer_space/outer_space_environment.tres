[gd_resource type="Environment" format=3 uid="uid://dajjvm7dcqc5h"]

[sub_resource type="Shader" id="Shader_space_sky"]
code = "shader_type sky;

vec3 hash3(vec3 p) {
	p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
	return fract(sin(p) * 43758.5453);
}

float hash1(vec3 p) {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

void sky() {
	vec3 direction = normalize(EYEDIR);
	vec3 color = vec3(0.008, 0.010, 0.024);

	float nebula_a = sin(direction.x * 7.0 + direction.y * 3.0 + sin(direction.z * 5.0)) * 0.5 + 0.5;
	float nebula_b = sin(direction.z * 9.0 - direction.x * 4.0 + cos(direction.y * 6.0)) * 0.5 + 0.5;
	float nebula = smoothstep(0.48, 0.88, nebula_a * 0.58 + nebula_b * 0.42);
	color += vec3(0.045, 0.018, 0.105) * nebula;
	color += vec3(0.012, 0.035, 0.085) * smoothstep(0.55, 0.92, nebula_b);

	vec3 star_grid = direction * 220.0;
	vec3 star_cell = floor(star_grid);
	vec3 star_local = fract(star_grid);
	vec3 star_point = hash3(star_cell) * 0.82 + 0.09;
	float star_distance = length(star_local - star_point);
	float star_chance = hash1(star_cell + vec3(19.7, 7.3, 41.1));
	float star_size = mix(0.025, 0.065, hash1(star_cell + vec3(3.1, 17.7, 9.2)));
	float star = (1.0 - smoothstep(star_size * 0.4, star_size, star_distance)) * step(0.94, star_chance);
	float star_tint = hash1(star_cell + vec3(8.2, 2.8, 31.4));
	vec3 star_color = mix(vec3(0.72, 0.84, 1.0), vec3(1.0, 0.88, 0.72), star_tint);
	color += star_color * star * 2.8;

	COLOR = color;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_space_sky"]
shader = SubResource("Shader_space_sky")

[sub_resource type="Sky" id="Sky_space"]
sky_material = SubResource("ShaderMaterial_space_sky")

